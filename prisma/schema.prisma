generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlanStatus {
  SAFE
  PENDING_DELIVERY
  DELIVERED
  REVOKED
  ARCHIVED
}

enum ContentType {
  LETTER
  INSTRUCTIONS
  AVATAR_QA
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         String    @default("SETTLOR")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plans        Plan[]
  confirmations ExecutorConfirmation[]
  auditLogs    AuditLog[]
}

model Plan {
  id                String    @id @default(cuid())
  settlorId         String
  name              String
  summary           String?
  cause             String?
  status            PlanStatus @default(SAFE)
  inactivityDays    Int       @default(60)
  executorThreshold Int       @default(2)
  executorCount     Int       @default(3)
  deliveredAt       DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  settlor       User                  @relation(fields: [settlorId], references: [id], onDelete: Cascade)
  contentItems  ContentItem[]
  fileAssets    FileAsset[]
  beneficiaries Beneficiary[]
  executors     Executor[]
  confirmations ExecutorConfirmation[]
  auditLogs     AuditLog[]
}

model ContentItem {
  id               String      @id @default(cuid())
  planId           String
  type             ContentType
  title            String
  encryptedPayload String
  metadata         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model FileAsset {
  id               String   @id @default(cuid())
  planId           String
  filename         String
  encryptedPath    String
  mimeType         String
  size             Int
  iv               String
  salt             String
  createdAt        DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Beneficiary {
  id          String   @id @default(cuid())
  planId       String
  name         String
  email        String
  relationship String?
  scope        String
  createdAt    DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Executor {
  id        String   @id @default(cuid())
  planId    String
  name      String
  email     String
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model ExecutorConfirmation {
  id         String   @id @default(cuid())
  executorId String
  planId     String
  userId     String?
  confirmedAt DateTime @default(now())

  plan     Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user     User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([executorId, planId])
}

model AuditLog {
  id        String   @id @default(cuid())
  planId    String?
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  plan Plan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
